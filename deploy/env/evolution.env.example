# Copy to /etc/leadflow/evolution.env on the VPS. Never commit the real file.
# The deploy script exports this file for Compose interpolation; only the
# explicit Evolution environment block in docker-compose.production.yml is
# passed to the container.
EVOLUTION_DATABASE_URL=postgresql://runtime-user:change-me@pooler.example:5432/postgres?schema=evolution_api
EVOLUTION_API_KEY=
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
REDIS_IMAGE=redis:7-alpine
