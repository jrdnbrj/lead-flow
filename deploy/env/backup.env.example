# Copy to /etc/leadflow/backup.env on the production VPS.
# Keep the real file root-owned with mode 0600. Never commit real values.

# Verified production Supabase PostgreSQL connection.
# Use the verified IPv4-reachable connection for this VPS. Keep the password
# out of this URL; the backup script uses SUPABASE_DB_PASSWORD separately.
SUPABASE_DB_URL=postgresql://postgres@verified-supabase-host:5432/postgres
SUPABASE_DB_PASSWORD=

# Cloudflare R2 S3-compatible credentials and endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=leadflow-backups
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
