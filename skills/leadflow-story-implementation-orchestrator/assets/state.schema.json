{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "runtime_status", "revision", "stories"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow": {"const": "leadflow-story-implementation-orchestrator"},
    "runtime_status": {"enum": ["IDLE", "RUNNING", "BLOCKED"]},
    "revision": {"type": "integer", "minimum": 0},
    "active_story_id": {"type": ["string", "null"]},
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["story_id", "story_file", "status", "dependencies", "execution_type"],
        "properties": {
          "story_id": {"type": "string", "pattern": "^E[0-9]+-S[0-9]+[a-z]?$"},
          "story_file": {"type": "string", "minLength": 1},
          "status": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "execution_type": {"enum": ["IMPLEMENTATION", "OPERATIONAL", "HYBRID", null]}
        }
      }
    }
  }
}
